# خطوات الربط موجودة بالتفصيل في DATABASE_SETUP_AR.md
# Project URL from Supabase Dashboard -> Connect
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the PUBLIC publishable key (sb_publishable_...), not secret/service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Alternatively, older projects may use: VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
# NEVER place a secret / service_role key in any VITE_ variable.
