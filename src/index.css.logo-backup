@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --navy: #172f35;
  --deep: #193a36;
  --paper: #fbfaf5;
  --lime: #dcf58d;
  --lilac: #dfd6ff;
  --blue: #c8e7f3;
  --orange: #ffb98c;
  --border: #e5e9e2;
}

@layer base {
  html { -webkit-tap-highlight-color: transparent; scroll-behavior: smooth; }
  body { font-family: 'IBM Plex Sans Arabic','Cairo',system-ui,sans-serif; line-height: 1.6; background: var(--paper); color: var(--navy); }
  h1,h2,h3,h4 { font-family:'Alexandria','IBM Plex Sans Arabic',sans-serif; line-height: 1.35; letter-spacing: -.045em; }
  button, input, select, textarea { font: inherit; }
  :focus-visible { outline: 3px solid #409e8b; outline-offset: 3px; }
  ::selection { background: var(--lime); color: var(--navy); }
}

/* A new, expressive visual language for all existing app screens, not only the homepage. */
.dawrak-app .shadow-soft { box-shadow: 0 14px 40px -29px rgba(17,49,46,.28); }
.dawrak-app .shadow-lift { box-shadow: 0 22px 55px -20px rgba(17,49,46,.17); }
.dawrak-app .bg-canvas { background: var(--paper); }
.dawrak-app .rounded-2xl { border-radius: 22px; }
.dawrak-app .rounded-3xl { border-radius: 29px; }
.dawrak-app .bg-brand-600 { background-color: #246b5c; }
.dawrak-app .hover\\:bg-brand-700:hover { background-color: #16483e; }
.dawrak-app input:focus,.dawrak-app select:focus,.dawrak-app textarea:focus { border-color: #389080; }

/* Navigation */
.site-header { background: #fbfaf5; border-bottom: 1px solid rgba(23,47,53,.09); position: sticky; z-index: 45; top: 0; }
.site-header-inner { min-height: 82px; max-width: 1360px; margin: auto; padding: 0 38px; display: flex; align-items: center; justify-content: space-between; gap: 34px; }
.new-brand-mark { display: inline-flex; align-items: center; gap: 11px; color: var(--navy); white-space: nowrap; }
.new-brand-mark strong { font-family:'Alexandria', sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -.07em; }
.brand-symbol { width: 43px; height: 43px; border-radius: 15px 15px 16px 4px; display: inline-flex; align-items: center; justify-content: center; background: var(--navy); color: var(--lime); position: relative; font-size: 27px; font-weight: 700; transform: rotate(-7deg); }
.brand-symbol span { display: inline-block; transform: rotate(7deg); line-height: 1; }
.brand-symbol i { width: 9px; height: 9px; border: 2px solid var(--paper); border-radius: 50%; position: absolute; top: -3px; left: -3px; }
.brand-mini-star { color: #ef925f; font-size: 15px; align-self: flex-start; margin-top: 1px; margin-right: -7px; }
.site-desktop-nav { display: flex; align-items: center; gap: 4px; margin-inline-start: auto; }
.site-desktop-nav a { font-size: 14px; font-weight: 700; color: #566d6b; padding: 13px 17px; border-radius: 15px; transition: .2s; }
.site-desktop-nav a:hover, .site-desktop-nav a.nav-is-active { color: var(--navy); background: #eaf1e7; }
.site-header-actions { display: flex; align-items: center; gap: 12px; }
.site-login { display: inline-flex; align-items: center; gap: 7px; color: var(--navy); padding: 11px; font-size: 14px; font-weight: 700; }
.site-join-button { display: inline-flex; align-items: center; gap: 16px; background: var(--navy); color: white; border-radius: 15px; padding: 12px 18px; font-size: 14px; font-weight: 700; transition: .2s; }
.site-join-button:hover { background: #315952; transform: translateY(-1px); }
.site-mobile-trigger { display:none; padding:10px; border-radius:12px; }
.site-mobile-menu { background: #fbfaf5; border-top:1px solid var(--border); box-shadow:0 18px 24px rgba(0,0,0,.06); }
.site-mobile-menu nav { display:grid; gap:2px; padding:14px 25px 22px; }
.site-mobile-menu a,.site-mobile-menu button { padding:12px 16px; border-radius:12px; text-align:right; font-weight:700; }
.site-mobile-menu .nav-is-active { background:#edf2e8; }
.preview-strip { min-height:38px; background:#eef2e5; color:#4d6155; display:flex; align-items:center; justify-content:center; gap:9px; flex-wrap:wrap; padding:7px 15px; font-size:12px; font-weight:600; }
.preview-strip a { color:#28584a; display:inline-flex; align-items:center; gap:3px; text-decoration: underline; text-underline-offset:3px; }
.site-footer { background: #f0f1ea; border-top: 1px solid #e0e5de; }
.site-footer-inner { max-width: 1360px; margin:auto; padding:35px 38px; display:flex; align-items:center; justify-content:space-between; gap:25px; }
.site-footer-inner > span { color:#75837c; font-size:13px; }
.site-footer-inner > div { display:flex; gap:23px; font-size:13px; font-weight:700; }
.site-footer-inner > div a:hover { text-decoration: underline; }

/* Hero — non-standard editorial composition */
.home-hero { position:relative; overflow:hidden; background:var(--navy); color:white; }
.home-hero-inner { max-width: 1360px; min-height: 645px; margin: auto; padding:80px 65px 118px 38px; display:grid; grid-template-columns: 1.1fr .9fr; align-items:center; gap:22px; position:relative; z-index:2; }
.home-hero-content { position:relative; z-index:5; }
.home-kicker { display:inline-flex; align-items:center; gap:9px; padding:8px 15px; border:1px solid rgba(220,245,141,.22); border-radius:50px; background:rgba(255,255,255,.05); color:var(--lime); font-size:13px; font-weight:700; }
.home-kicker-dot { width:8px; height:8px; display:inline-block; border-radius:50%; background:var(--lime); box-shadow:0 0 0 4px rgba(220,245,141,.12); }
.home-title { font-size:clamp(52px,5.35vw,84px); color:#fff; font-weight:800; line-height:1.32; margin:20px 0 8px; letter-spacing:-.095em; }
.home-title span { color:var(--lime); }
.home-description { color:#bfd2c9; font-size:clamp(15px,1.55vw,19px); line-height:1.9; margin:0 0 29px; }
.home-search { width:min(750px, 110%); background:white; padding:7px; border-radius:25px; box-shadow:0 22px 65px rgba(0,0,0,.21); color:var(--navy); }
.home-search-tabs { display:flex; gap:5px; padding:4px; }
.home-search-tabs button { display:inline-flex; align-items:center; gap:8px; justify-content:center; padding:10px 18px; border-radius:14px; font-weight:700; font-size:14px; color:#667974; transition:.2s; }
.home-search-tabs button.is-selected { background:var(--navy); color:white; }
.home-search-tabs button:not(.is-selected):hover { background:#edf3eb; }
.home-search-fields { display:flex; gap:5px; padding:7px 3px 3px; border-top:1px solid #edf0e9; align-items:center; }
.home-search-input,.home-search-location { display:flex; align-items:center; gap:9px; min-width:0; color:#80918a; }
.home-search-input { flex:1 1 auto; padding:9px 11px; }
.home-search-input input { width:100%; min-width:0; outline:none; border:0; font-size:14px; color:var(--navy); background:transparent; }
.home-search-input input::placeholder { color:#8a9a94; }
.home-search-location { border-right:1px solid #e7ebe4; padding:10px 7px 10px 10px; max-width:178px; }
.home-search-location select { min-width:0; width:127px; appearance:none; border:0; color:#546964; font-size:13px; outline:none; background:transparent; cursor:pointer; }
.home-location-arrow { flex-shrink:0; }
.home-search-submit { display:inline-flex; align-items:center; justify-content:center; gap:14px; background:var(--lime); color:var(--navy); padding:13px 18px; border-radius:14px; font-weight:800; font-size:14px; white-space:nowrap; transition:.2s; }
.home-search-submit:hover { background:#c8ee6b; transform:translateY(-1px); }
.home-hero-shortcut { display:flex; gap:12px; margin-top:20px; align-items:center; font-size:13px; color:#a9bcb2; }
.home-hero-shortcut a { color:#e1f29e; font-weight:700; display:inline-flex; gap:5px; align-items:center; border-bottom:1px solid #829d7b; }
.home-hero-wave { position:absolute; z-index:3; left:0; right:0; bottom:-1px; height:55px; background:var(--paper); clip-path:polygon(0 58%, 18% 93%, 47% 50%, 72% 86%, 100% 26%, 100% 100%, 0 100%); }
.home-hero-doodle { position:absolute; pointer-events:none; }
.home-doodle-one { width:440px;height:440px; background:#306657; border-radius:50%; filter:blur(150px); top:-270px; right:-130px; opacity:.33; }
.home-doodle-two { width:420px;height:420px; background:#6b7b71; border-radius:50%; filter:blur(150px); bottom:-320px; left:23%; opacity:.27; }
.home-visual { height:440px; width:100%; max-width:525px; position:relative; justify-self:center; }
.visual-orbit { position:absolute; border-radius:50%; border:1px dashed rgba(220,245,141,.24); pointer-events:none; }
.visual-orbit-one { width:455px; height:455px; left:0; top:0; transform:rotate(10deg); }
.visual-orbit-two { width:300px; height:300px; left:70px; top:68px; }
.visual-main-card { background:#fbfaf4; color:var(--navy); position:absolute; width:340px; top:63px; left:60px; transform:rotate(-7deg); padding:22px; border-radius:28px; box-shadow:0 34px 70px rgba(0,0,0,.27); }
.visual-card-top { display:flex; align-items:center; justify-content:space-between; font-weight:700; font-size:15px; }
.visual-card-heading { display:flex; align-items:center; gap:9px; }
.visual-card-heading svg { color:#42806b; }
.visual-dots { color:#a6b5aa; letter-spacing:3px; }
.visual-date-line { margin-top:30px; display:flex; align-items:center; gap:14px; }
.visual-date-day { font-family:'Alexandria',sans-serif; font-size:68px; font-weight:800; letter-spacing:-.09em; line-height:1; }
.visual-date-line strong { display:block; font-size:20px; }
.visual-date-line small { display:block; font-size:12px; color:#6f8075; }
.visual-green-tag { font-size:11px; display:flex; gap:4px; align-items:center; margin-inline-start:auto; font-weight:700; background:#e0f4c6; padding:7px 9px; border-radius:50px; }
.visual-separator { border-top:2px dashed #dae0d6; margin-top:28px; margin-bottom:22px; }
.visual-appointment { display:flex; align-items:center; gap:11px; }
.visual-doctor-icon { width:43px; height:43px; display:grid; place-items:center; background:#cfebdf; color:#206855; border-radius:15px; }
.visual-appointment strong,.visual-appointment small { display:block; }
.visual-appointment strong { font-size:13px; }
.visual-appointment small { color:#7a8b82; font-size:11px; }
.visual-appointment-badge { margin-inline-start:auto; font-size:12px; font-weight:800; color:#2d8068; }
.visual-float-card { position:absolute; bottom:12px; right:8px; background:var(--lilac); border:4px solid var(--navy); border-radius:24px; transform:rotate(8deg); width:258px; padding:17px 19px; display:flex; align-items:center; gap:12px; color:var(--navy); box-shadow:0 15px 25px rgba(0,0,0,.21); }
.visual-float-icon { display:grid; place-items:center; background:#fff; border-radius:15px; width:52px; height:52px; color:#584996; }
.visual-float-card small,.visual-float-card strong { display:block; }
.visual-float-card small { color:#605781; font-size:12px; }
.visual-float-card strong { font-size:18px; font-weight:800; }
.visual-seats { display:flex; gap:4px; margin-top:9px; }
.visual-seats i { width:20px; height:6px; border-radius:5px; background:#7665cf; }
.visual-seats i:nth-child(n+4) { background:#b8aef0; }
.visual-notice { position:absolute; top:29px; right:0; border-radius:18px; display:flex; gap:9px; align-items:center; padding:14px 18px; background:var(--lime); color:var(--navy); font-weight:800; font-size:15px; transform:rotate(9deg); box-shadow:0 12px 28px rgba(0,0,0,.18); }
.visual-notice-icon { width:27px; height:27px; display:grid; place-items:center; background:var(--navy); border-radius:9px; color:var(--lime); }
.visual-spark { position:absolute; font-size:52px; color:var(--orange); }
.visual-spark-a { top:-16px; left:25px; }
.visual-spark-b { bottom:16px; left:22px; font-size:37px; }

/* Scannable home sections: tiny amount of copy, memorable blocks */
.home-choice-section,.home-explore,.home-pro-section { max-width:1260px; margin:auto; padding:72px 34px; }
.home-section-heading { text-align:center; margin-bottom:34px; }
.section-marker { display:inline-block; font-size:12px; font-weight:800; color:#598279; letter-spacing:.015em; }
.home-section-heading h2,.home-explore h2 { font-size:clamp(30px,3vw,44px); font-weight:800; margin:6px 0 0; }
.home-choice-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; }
.choice-feature { min-height:290px; position:relative; overflow:hidden; padding:34px; border-radius:34px; transition:transform .2s,box-shadow .2s; display:flex; flex-direction:column; justify-content:space-between; }
.choice-feature:hover { transform:translateY(-5px); box-shadow:0 23px 40px -26px rgba(20,45,40,.35); }
.choice-doctor { background:var(--blue); }
.choice-teacher { background:var(--lilac); }
.choice-inner { display:flex; align-items:flex-start; gap:22px; position:relative; z-index:2; }
.choice-icon { width:82px; height:82px; border:2px solid rgba(23,47,53,.12); background:rgba(255,255,255,.48); border-radius:27px; display:grid; place-items:center; flex-shrink:0; transform:rotate(-8deg); }
.choice-overline { font-size:13px; font-weight:700; color:#487277; }
.choice-feature h3 { font-size:clamp(24px,2.4vw,38px); font-weight:800; margin:5px 0; }
.choice-feature p { font-size:14px; color:#526870; max-width:275px; line-height:1.8; }
.choice-arrow { align-self:flex-end; background:var(--navy); color:white; display:grid; place-items:center; width:54px; height:54px; border-radius:50%; z-index:2; }
.choice-decor { position:absolute; left:-70px; bottom:-104px; width:285px; height:285px; border:3px solid rgba(23,47,53,.10); border-radius:50%; }
.choice-decor span { position:absolute; inset:35px; border:3px solid rgba(23,47,53,.1); border-radius:50%; }
.choice-decor span:nth-child(2) { inset:80px; }
.choice-decor span:nth-child(3) { inset:123px; }
.home-flow { background:#edf0e7; margin-top:14px; padding:70px 30px; }
.home-flow-inner { max-width:1240px; margin:auto; display:grid; grid-template-columns: 300px 1fr; align-items:center; gap:44px; }
.flow-intro h2 { font-size:clamp(38px,3.8vw,55px); line-height:1.3; font-weight:800; margin-top:12px; }
.flow-intro h2 em { font-style:normal; color:#31816e; }
.flow-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:17px; }
.flow-steps > div { position:relative; background:#fbfaf5; border-radius:25px; padding:23px; min-height:180px; display:flex; flex-direction:column; gap:5px; align-items:flex-start; }
.flow-steps .flow-num { align-self:flex-end; font-family:'Alexandria',sans-serif; color:#acb8ad; font-size:16px; font-weight:800; }
.flow-steps svg { color:#317c6a; margin-top:-12px; }
.flow-steps strong { font-family:'Alexandria',sans-serif; font-size:23px; margin-top:9px; }
.flow-steps small { color:#6a7c75; font-size:12px; }
.home-explore-head { display:flex; justify-content:space-between; align-items:end; gap:18px; margin-bottom:28px; }
.home-explore-head p { color:#7c8b81; font-size:13px; }
.explore-columns { display:grid; grid-template-columns:1fr 1fr; gap:23px; }
.explore-panel { background:#fff; border:1px solid #e7e9e2; border-radius:30px; padding:27px; }
.explore-label { display:flex; align-items:center; gap:13px; margin-bottom:20px; }
.explore-label h3 { font-size:19px; font-weight:800; }
.explore-label-icon { width:45px; height:45px; border-radius:14px; display:grid; place-items:center; background:#e0f4e7; color:#246e5b; }
.explore-panel-edu .explore-label-icon { background:#e7ddff; color:#6b4ab1; }
.explore-label > a { margin-inline-start:auto; display:inline-flex; align-items:center; gap:5px; font-size:13px; font-weight:700; color:#447366; }
.explore-chips { display:flex; flex-wrap:wrap; gap:9px; }
.explore-chips a { border:1px solid #e2e8e0; background:#fafbf7; padding:9px 14px; border-radius:50px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:9px; transition:.2s; }
.explore-chips a:hover { background:#e4f4d2; border-color:#b9dcac; transform:translateY(-2px); }
.explore-panel-edu .explore-chips a:hover { background:#eee7ff; border-color:#c8b5ee; }
.home-pro-section { padding-top:10px; }
.home-pro-card { position:relative; overflow:hidden; background:#dcf58d; border-radius:37px; padding:51px 56px; display:flex; align-items:center; gap:42px; }
.home-pro-icon { flex-shrink:0; width:96px;height:96px; border:2px solid var(--navy); border-radius:34px; display:grid; place-items:center; transform:rotate(-9deg); }
.home-pro-copy { z-index:2; }
.home-pro-copy > span { font-size:13px; font-weight:700; color:#426950; }
.home-pro-copy h2 { font-size:clamp(28px,3.4vw,48px); font-weight:800; margin:5px 0; line-height:1.32; }
.home-pro-copy p { font-size:14px; color:#597455; }
.home-pro-link { display:flex; align-items:center; gap:13px; padding:14px 20px; background:var(--navy); color:white; border-radius:17px; font-size:14px; font-weight:800; margin-inline-start:auto; z-index:2; white-space:nowrap; }
.home-pro-scribble { position:absolute; left:22px; top:-88px; opacity:.1; font-size:330px; }
.home-lower-note { text-align:center; font-size:12px; color:#799087; padding-bottom:37px; }
.home-lower-note span { font-weight:800; }
.home-lower-note .home-kicker-dot { width:7px;height:7px;margin-inline-end:4px; }

/* Purpose-built professional selection */
.join-redesign { max-width:1170px; margin:auto; padding:70px 32px 100px; }
.join-intro { text-align:center; }
.join-intro .home-kicker { background:#e8f0e4; color:#296b57; border-color:#dce8d5; }
.join-intro h1 { font-size:clamp(40px,5vw,68px); font-weight:800; line-height:1.35; margin:16px 0 7px; }
.join-intro h1 span { color:#46816d; }
.join-intro p { color:#687e75; font-size:16px; }
.join-options { margin-top:45px; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px; }
.join-option { position:relative; min-height:405px; padding:29px 33px; border-radius:36px; overflow:hidden; display:flex; flex-direction:column; transition:.25s; }
.join-option:hover { transform:translateY(-5px); box-shadow:0 22px 42px -24px rgba(22,45,42,.3); }
.join-option-med { background:#cfeaf0; }
.join-option-edu { background:#dfd6ff; }
.join-option-pattern { position:absolute; font-size:220px; line-height:1; font-weight:300; top:10px; left:8px; opacity:.12; }
.join-option-tag { align-self:flex-start; padding:9px 15px; border-radius:100px; display:inline-flex; align-items:center; gap:7px; background:rgba(255,255,255,.6); font-size:13px; font-weight:700; }
.join-illustration { height:180px; display:grid; place-items:center; position:relative; transform:rotate(-8deg); }
.join-illustration > svg { background:rgba(255,255,255,.54); border:2px dashed rgba(22,47,53,.2); border-radius:34px; width:138px;height:138px; padding:30px; }
.join-med-bubble,.join-edu-bubble { position:absolute; top:22px; left:20%; background:#172f35; color:#dcf58d; padding:11px 14px; border-radius:14px; transform:rotate(15deg); font-size:16px; font-weight:800; }
.join-option-bottom { margin-top:auto; display:flex; align-items:end; justify-content:space-between; position:relative; z-index:2; }
.join-option-bottom h2 { font-size:42px; font-weight:800; }
.join-option-bottom p { font-size:14px; margin-top:2px; color:#5a6e73; }
.join-option-arrow { width:57px;height:57px; display:grid; place-items:center; background:var(--navy); border-radius:50%; color:white; }
.join-bottom-note { text-align:center; display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:35px; font-size:14px; color:#76867d; }
.join-bottom-note a { color:#256b5d; font-weight:800; }

/* Distinct, compact interior screens */
.dawrak-app main > .animate-fade-up > section:not(.join-redesign) { position:relative; }
.dawrak-app main > .animate-fade-up > section:not(.join-redesign) > .flex:first-child h1 { letter-spacing:-.055em; }
.dawrak-app .bg-white { background-color:#fffefd; }
.dawrak-app .border-ink-100 { border-color:#e7eae3; }
.dawrak-app .bg-ink-50 { background-color:#f0f2ee; }
.dawrak-app .text-ink-900 { color:var(--navy); }
.dawrak-app .text-ink-500 { color:#667c77; }
.dawrak-app .text-ink-600 { color:#596f69; }
.dawrak-app .text-ink-700 { color:#3a5a54; }
.dawrak-app .bg-edu-600 { background-color:#6950aa; }
.dawrak-app .bg-edu-50 { background-color:#eee9fc; }
.dawrak-app .text-edu-700 { color:#6648a0; }
.dawrak-app .bg-brand-50 { background-color:#e9f4ed; }
.dawrak-app .text-brand-700 { color:#286b59; }
.dawrak-app .border-brand-200 { border-color:#c2dcd0; }

@keyframes fade-up { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
@keyframes shimmer { 0% { background-position:-200% 0; } 100% { background-position:200% 0; } }
.animate-fade-up { animation:fade-up .45s ease-out both; }
.skeleton { background:linear-gradient(90deg,#e6ecf0 25%,#f4f6f3 37%,#e6ecf0 63%);background-size:400% 100%;animation:shimmer 1.4s ease infinite; }

@media (max-width:1050px) {
  .site-header-inner { padding:0 24px; }
  .site-desktop-nav { gap:0; }
  .site-desktop-nav a { padding:11px; }
  .home-hero-inner { padding-right:33px; }
  .home-visual { transform:scale(.85); transform-origin:center; }
  .home-search { width:100%; }
  .home-flow-inner { grid-template-columns: 245px 1fr; gap:20px; }
  .home-pro-card { gap:23px; padding:40px; }
}
@media (max-width:780px) {
  .site-header-inner { min-height:72px; padding:0 20px; }
  .site-desktop-nav,.site-header-actions { display:none; }
  .site-mobile-trigger { display:inline-grid; place-items:center; }
  .new-brand-mark strong { font-size:22px; }
  .brand-symbol { width:38px;height:38px; }
  .home-hero-inner { min-height:auto; display:flex; flex-direction:column; align-items:stretch; padding:55px 22px 98px; gap:0; }
  .home-title { font-size:clamp(47px,9vw,72px); }
  .home-description { font-size:15px; }
  .home-visual { order:-1; align-self:center; height:260px; margin-bottom:5px; transform:scale(.6); width:420px; margin-top:-90px; margin-bottom:85px; }
  .home-search { width:100%; }
  .home-choice-section,.home-explore,.home-pro-section { padding:48px 20px; }
  .home-choice-grid,.explore-columns { grid-template-columns:1fr; }
  .choice-feature { min-height:230px; }
  .home-flow { padding:47px 20px; }
  .home-flow-inner { display:block; }
  .flow-intro h2 br { display:none; }
  .flow-steps { margin-top:23px; }
  .home-pro-card { flex-wrap:wrap; }
  .home-pro-link { margin-inline-start:0; }
  .site-footer-inner { padding:30px 22px; flex-wrap:wrap; }
  .join-redesign { padding:45px 20px 80px; }
}
@media (max-width:570px) {
  .home-visual { height:214px; margin-top:-110px; margin-bottom:94px; transform:scale(.5); }
  .home-kicker { font-size:11px; }
  .home-title { font-size:51px; }
  .home-search-fields { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
  .home-search-input { grid-column:1 / -1; min-height:46px; }
  .home-search-location { border-right:0; grid-column:1; max-width:none; padding:10px; background:#f2f5ef; border-radius:13px; }
  .home-search-location select { width:100%; }
  .home-search-submit { grid-column:2; padding:12px; }
  .home-hero-shortcut { font-size:12px; }
  .choice-inner { display:block; }
  .choice-feature h3 { font-size:30px; margin-top:10px; }
  .choice-icon { width:64px;height:64px; border-radius:20px; }
  .flow-steps { grid-template-columns:1fr; }
  .flow-steps > div { min-height:auto; display:grid; grid-template-columns:38px 1fr; column-gap:12px; align-items:center; padding:15px 20px; }
  .flow-steps .flow-num { grid-row:1 / 3; align-self:center; }
  .flow-steps svg { display:none; }
  .flow-steps strong { grid-column:2; margin:0; font-size:19px; }
  .flow-steps small { grid-column:2; }
  .home-explore-head { display:block; }
  .home-explore-head p { margin-top:10px; }
  .home-pro-card { padding:32px 25px; border-radius:27px; gap:16px; }
  .home-pro-icon { width:68px;height:68px; border-radius:23px; }
  .home-pro-copy h2 { font-size:30px; }
  .join-options { grid-template-columns:1fr; }
  .join-option { min-height:325px; }
  .join-illustration { height:120px; }
  .join-illustration > svg { width:100px;height:100px; padding:23px; }
  .join-option-bottom h2 { font-size:35px; }
  .site-footer-inner { display:flex; flex-direction:column; text-align:center; }
  .site-footer-inner > div { flex-wrap:wrap; justify-content:center; }
}
@media (prefers-reduced-motion:reduce) {
  .animate-fade-up,.skeleton { animation:none; }
  *,*::before,*::after { scroll-behavior:auto!important; transition-duration:.01ms!important; }
}
/* Doctor and teacher discovery: focused search rather than 8 open filters */
.search-page { padding-bottom:85px; }
.search-hero { background:var(--blue); overflow:hidden; }
.search-teacher .search-hero { background:var(--lilac); }
.search-hero-inner { max-width:1260px; margin:auto; padding:53px 35px 96px; position:relative; display:flex; justify-content:space-between; align-items:center; }
.search-hero-eyebrow { display:inline-flex; align-items:center; gap:7px; color:#356d74; font-size:13px; font-weight:800; }
.search-hero h1 { font-size:clamp(36px,4.4vw,62px); font-weight:800; line-height:1.3; margin:12px 0; }
.search-hero h1 em { font-style:normal; color:#27826c; }
.search-teacher .search-hero h1 em { color:#7351af; }
.search-hero p { color:#556f76; font-size:15px; }
.search-hero-decoration { width:190px;height:190px;border-radius:55px; background:rgba(255,255,255,.32); transform:rotate(-13deg); display:grid;place-items:center; color:#396d76; position:absolute; top:20px; left:16%; }
.search-hero-decoration span { position:absolute; top:-30px;right:-31px;font-size:80px; color:rgba(37,99,93,.36); }
.search-teacher .search-hero-decoration { color:#7565ae; }
.search-body { max-width:1260px;margin:-52px auto 0; padding:0 35px; position:relative; z-index:2; }
.search-filter-panel { background:#fff; border:1px solid #e5eae5; padding:24px 27px; border-radius:28px; box-shadow:0 20px 50px -34px rgba(20,53,44,.38); }
.search-filter-heading { display:flex; gap:10px; align-items:center; justify-content:space-between; margin-bottom:15px; }
.search-filter-heading strong { display:inline-flex;align-items:center;gap:9px;font-family:'Alexandria',sans-serif;font-size:17px; }
.search-filter-heading > span { color:#8b9890; font-size:12px; }
.search-core-filters { display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:12px; }
.search-core-filters input,.search-core-filters select,.search-extra-grid input,.search-extra-grid select { border-radius:13px; background:#f7f8f4; border-color:#e6ebe5; }
.search-more-filters { margin-top:15px; border-top:1px solid #edf0ea; padding-top:10px; }
.search-more-filters summary { cursor:pointer; display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:800;color:#326c5b;padding:6px 0;list-style:none; }
.search-more-filters summary::-webkit-details-marker { display:none; }
.search-more-filters summary span { font-size:11px; font-weight:400; color:#8b9993; }
.search-extra-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:15px; }
.search-available { align-self:end;min-height:44px;display:flex;align-items:center;gap:9px;font-size:13px;font-weight:700; }
.search-available input { accent-color:#2f7b66;width:17px;height:17px; }
.search-clear { display:block;margin-top:12px;font-size:12px;color:#6c786d;text-decoration:underline;text-underline-offset:4px; }
.search-results-heading { display:flex;align-items:center;justify-content:space-between; gap:15px; margin:37px 2px 22px; }
.search-results-heading h2 { font-size:clamp(23px,2.4vw,30px); font-weight:800; }
.search-results-heading h2 span { color:#538878; }
.search-teacher .search-results-heading h2 span { color:#785bad; }
.search-results-heading > span { background:#ebf0e9;padding:6px 14px;border-radius:80px;font-size:12px;font-weight:800;color:#536e61; }
.search-reset-action { margin-top:12px; padding:10px 18px; background:#234d42; color:white; border-radius:13px;font-weight:700;font-size:13px; }
@media(max-width:780px) { .search-hero-inner { padding:47px 23px 94px; }.search-hero-decoration { left:4%;opacity:.4;transform:rotate(-17deg) scale(.7); }.search-body { padding:0 20px; }.search-core-filters { grid-template-columns:1fr 1fr; }.search-core-filters > :first-child { grid-column:1/-1; }.search-extra-grid { grid-template-columns:1fr 1fr; } }
@media(max-width:570px) { .search-hero-decoration { display:none; }.search-hero h1 { font-size:36px; }.search-filter-panel { padding:18px; }.search-core-filters,.search-extra-grid { grid-template-columns:1fr; }.search-core-filters > :first-child { grid-column:auto; }.search-more-filters summary span { display:none; } }
/* Directory tickets */
.directory-card { display:flex; flex-direction:column; background:#fff; border:1px solid #e5e9e2; border-radius:25px; overflow:hidden; min-height:307px; box-shadow:0 14px 30px -27px rgba(23,52,46,.4); transition:transform .2s,box-shadow .2s; }
.directory-card:hover { transform:translateY(-4px); box-shadow:0 22px 36px -25px rgba(23,52,46,.29); }
.directory-card-stripe { min-height:56px; display:flex;justify-content:space-between; align-items:center; padding:12px 20px; background:#d3eaf0; color:#29566a; font-size:12px; font-weight:800; }
.teacher-directory-card .directory-card-stripe { background:#e0d7fa; color:#65469e; }
.directory-card-stripe > span:first-child { display:inline-flex;align-items:center;gap:8px; }
.directory-card-mark { font-size:29px; font-weight:300; line-height:1; opacity:.65; }
.directory-card-body { padding:23px 21px 17px; flex:1; }
.directory-profile-row { display:flex;align-items:center;gap:15px; }
.directory-profile-copy { min-width:0; }
.directory-profile-copy h3 { font-size:17px; font-weight:800; white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.directory-profile-copy p { color:#7c8b82; font-size:12px; margin-top:5px;display:flex;align-items:center;gap:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.directory-avatar { width:64px;height:64px;border-radius:20px;flex-shrink:0;object-fit:cover; }
.directory-avatar-placeholder { background:#eee5fe;color:#7455ab; display:grid; place-items:center;font-weight:800;font-size:23px; }
.directory-info-lines { margin-top:18px; display:flex;flex-wrap:wrap; align-items:center;justify-content:space-between;gap:11px; }
.directory-info-lines>span { display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#677a73; }
.directory-info-lines b { color:#183d32; }
.teacher-info-lines .seat-indicator { padding:6px 9px; border-radius:30px; font-weight:800; }
.seat-open { background:#e3f4dc;color:#2d7049!important; }
.seat-full { background:#fae6e1;color:#9b5146!important; }
.directory-cta { margin:0 17px 16px; padding:8px 8px 8px 16px; border-top:1px dashed #d9e1d8; display:flex;align-items:center;justify-content:space-between;gap:14px;font-size:13px;font-weight:800;color:#2b6555; }
.directory-cta>span { width:37px;height:37px;display:grid;place-items:center;border-radius:12px;background:#e4f2e3; transition:.2s; }
.directory-cta:hover>span { background:#d0eec6; transform:rotate(-8deg); }
.teacher-directory-card .directory-cta { color:#6e4eab; }
.teacher-directory-card .directory-cta>span { background:#eee9fb; }
/* Service-provider workspaces retain the real functions, with a visual hierarchy unlike an admin template */
.work-dashboard { padding-bottom:85px; }
.work-hero { border-radius:32px; min-height:210px; padding:38px 42px; display:flex; align-items:center; justify-content:space-between; gap:30px; position:relative; overflow:hidden; background:#dfd6ff; }
.work-hero > *:not(.work-hero-art) { position:relative;z-index:2; }
.doctor-work-hero { background:#c8e7f1; }
.work-hero-label { font-size:13px;font-weight:800;color:#5c5195; margin-bottom:9px; }
.doctor-work-hero .work-hero-label { color:#497d80; }
.work-hero h1 { font-size:clamp(27px,3.2vw,41px);font-weight:800; }
.work-hero h1 span { color:#997cc7; }
.doctor-work-hero h1 span { color:#4a9498; }
.work-hero p:not(.work-hero-label) { font-size:13px;color:#605d79;margin-top:8px; }
.work-hero .work-hero-art { font-size:260px; line-height:1; position:absolute;left:23%;bottom:-105px;color:rgba(81,64,147,.11);transform:rotate(14deg); }
.doctor-work-hero .work-hero-art { color:rgba(34,105,103,.15); }
.work-hero button { background:var(--navy);border-radius:15px;padding:14px 21px; }
.work-stats > div { border:0!important; box-shadow:none!important; border-radius:25px!important; background:#fff!important; min-height:110px; }
.work-stats > div:nth-child(1) { background:#e8f3de!important; }
.work-stats > div:nth-child(2) { background:#f7e8df!important; }
.work-stats > div:nth-child(3) { background:#e9e5fa!important; }
.work-stats > div > span { border-radius:16px; background:#fff9!important; }
/* KPI text sizes are controlled by explicit selectors below, not p:last-child. */
.work-share > div, .doctor-work-dashboard > div:has(> .grid) { border-radius:24px; }
.work-group-card { border-radius:25px!important; box-shadow:none!important; border:1px solid #e7e8e0!important; background:#fffefd!important; position:relative; overflow:hidden; }
.work-group-card:before { content:'';height:6px;position:absolute;top:0;left:0;right:0;background:#bcade9; }
.work-group-card .bg-edu-500 { background:#9d83d8; }
.work-dashboard .border-t { border-color:#e5ebe4; }
@media(max-width:570px){.work-hero{padding:27px;min-height:175px;flex-wrap:wrap;}.work-hero h1{font-size:26px;}.work-hero .work-hero-art{left:-8%;}.work-stats{grid-template-columns:1fr 1fr;}.work-stats > div:last-child{grid-column:1/-1;}}
/* A real interactive (but explicitly local) demonstration, presented like a booking ticket */
.demo-reimagined { max-width:1100px; margin:auto; padding:66px 30px 100px; }
.demo-heading { text-align:center; }
.demo-badge { display:inline-flex; align-items:center;gap:9px;padding:8px 15px;border-radius:50px;background:#e8eee2;color:#587263;font-size:12px;font-weight:800; }
.demo-heading h1 { font-size:clamp(37px,4.4vw,60px);font-weight:800;margin:13px 0 6px; }
.demo-heading h1 span { color:#8772c8; }
.demo-heading p { color:#75867c;font-size:15px; }
.demo-layout { display:grid;grid-template-columns:1.05fr .95fr; gap:27px; margin-top:38px; align-items:stretch; }
.demo-ticket { background:#dfd6ff;border-radius:30px;overflow:hidden;position:relative; }
.demo-ticket-top { padding:24px 27px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:800;color:#5a4c88; }
.demo-ticket-top span:first-child { display:flex;align-items:center;gap:8px; }
.demo-ticket-inner { padding:15px 32px 34px; }
.demo-ticket-inner > p { color:#71649c;font-size:13px;font-weight:700; }
.demo-ticket-inner h2 { font-size:clamp(34px,3.2vw,50px);font-weight:800;margin:13px 0; }
.demo-ticket-inner > span { font-size:13px;color:#675f87; }
.demo-ticket-cut { border-top:2px dashed #bcb0e0; position:relative; }
.demo-ticket-cut:after,.demo-ticket-cut:before { content:'';position:absolute;width:30px;height:30px;border-radius:50%;background:var(--paper);top:-16px; }
.demo-ticket-cut:before { right:-14px; }.demo-ticket-cut:after { left:-14px; }
.demo-ticket-bottom { display:flex;gap:50px;padding:22px 32px 6px; }
.demo-ticket-bottom >div { display:flex;flex-direction:column;gap:3px; }
.demo-ticket-bottom span { font-size:12px;color:#6c6395; }
.demo-ticket-bottom strong { font-family:'Alexandria',sans-serif;font-size:35px; }
.demo-ticket-bottom small { font-size:18px;opacity:.5; }
.demo-progress { height:9px;background:rgba(255,255,255,.55);border-radius:20px;margin:0 32px 31px;overflow:hidden; }
.demo-progress > span { display:block;height:100%;background:#775bc4;transition:width .4s; }
.demo-action-panel { display:flex;align-items:start;flex-direction:column;justify-content:center;background:#fff; border-radius:30px;padding:35px;border:1px solid #e9eae4; }
.demo-availability { background:#e1f1d9;color:#37744b;padding:7px 13px;border-radius:100px;font-size:12px;font-weight:800; }
.demo-availability.demo-full { background:#ffebdf;color:#a95b4a; }
.demo-action-panel h2 { font-size:31px;font-weight:800;margin:16px 0 7px; }
.demo-action-panel > p { color:#708179;font-size:13px; }
.demo-book-button { display:flex;align-items:center;justify-content:center;gap:12px;width:100%;background:var(--navy);color:white;font-weight:800;border-radius:17px;min-height:55px;margin-top:27px;transition:.2s; }
.demo-book-button:hover:not(:disabled) { background:#315b4b; }
.demo-book-button:disabled { opacity:.5;cursor:not-allowed; }
.demo-book-button svg:last-child { margin-inline-start:auto; margin-inline-end:18px; }
.demo-book-button svg:first-child { margin-inline-start:18px; }
.demo-reset { display:inline-flex;align-items:center;gap:8px;color:#4a7264;font-size:12px;font-weight:800;margin-top:17px; }
.demo-alternative { background:#e8f4d9;border-radius:16px;padding:15px 18px;margin-top:18px;width:100%; }
.demo-alternative strong { font-size:15px; }.demo-alternative p,.demo-alternative span { display:block;color:#667d58;font-size:12px;margin-top:5px; }
.demo-action-panel .demo-disclaimer { margin-top:21px;font-size:11px;color:#a1aba2;line-height:1.6; }
.demo-paths { display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:20px; }
.demo-paths a { display:flex;align-items:center;gap:13px;background:#eef0e9;padding:17px 22px;border-radius:18px;font-weight:800;font-size:14px; }
.demo-paths a svg:last-child { margin-inline-start:auto; }
@media(max-width:750px){.demo-reimagined{padding:43px 19px 75px;}.demo-layout{grid-template-columns:1fr;}.demo-action-panel{padding:25px;}.demo-paths{grid-template-columns:1fr;}}
@media(max-width:780px){.home-visual{display:none}.home-hero-inner{padding-top:62px}}
/* Auth screens with intentional split instead of a generic centered login box */
.auth-redesign { min-height:calc(100vh - 84px);display:flex;align-items:center;justify-content:center; padding:65px 28px; }
.auth-layout { max-width:1040px;width:100%;display:grid;grid-template-columns:.85fr 1fr; gap:30px; }
.auth-aside { min-height:500px;background:#dff18c;border-radius:34px;position:relative;overflow:hidden;padding:37px;display:flex;flex-direction:column;justify-content:space-between; }
.auth-aside-top span { display:inline-flex;gap:9px;align-items:center;font-size:13px;font-weight:800; }
.auth-aside h2 { font-size:clamp(36px,4vw,56px);line-height:1.38;font-weight:800;position:relative;z-index:2; }
.auth-aside h2 em { font-style:normal;color:#3d7053; }
.auth-aside p { max-width:300px;color:#50765b;margin-top:15px;font-size:14px;position:relative;z-index:2; }
.auth-aside-note { position:relative;z-index:2;display:flex;gap:8px;align-items:center;font-size:13px;font-weight:800; }
.auth-aside-art { position:absolute;font-size:450px;left:-100px;bottom:-155px;color:rgba(49,89,48,.11);line-height:1; }
.auth-form-side { background:#fff;border:1px solid #e6eae3;border-radius:34px;padding:34px 35px; }
.auth-form-top { display:flex;justify-content:space-between;align-items:center;color:#94a198;font-size:12px;font-weight:800;margin-bottom:55px; }
.auth-form-spark { color:#b6a5ed;font-size:31px; }
.auth-form-card { border:0!important;box-shadow:none!important;padding:0!important; }
.auth-form-card h1 { font-size:clamp(25px,2.7vw,34px);font-weight:800;margin-bottom:7px; }
.auth-form-card > p { color:#829089;font-size:13px;line-height:1.8; }
.auth-form-card button[type=submit] { min-height:50px;border-radius:15px;background:var(--navy); }
.auth-form-footer { text-align:center;margin-top:29px;font-size:13px;color:#667e71; }
@media(max-width:820px){.auth-layout{grid-template-columns:1fr;max-width:520px;}.auth-aside{display:none;}.auth-form-top{margin-bottom:34px;}.auth-form-side{padding:26px;}.auth-redesign{padding:36px 17px;}}

/* ═══════════════════════════════════════════════════════════
   DAWRAK / SIGNATURE EDITION — PHOTOGRAPHIC DESIGN SYSTEM
   The three photographs are supplied by the project owner.
   No fabricated profile photography is used for actual listings.
   ═══════════════════════════════════════════════════════════ */
:root {
  --navy: #173831;
  --deep: #143d38;
  --paper: #fafaf7;
  --lime: #e7f4bd;
  --lilac: #e7e0f2;
  --blue: #dceef0;
}
body { background:var(--paper); }
.dawrak-app .bg-canvas { background:var(--paper); }
.site-header {
  background:rgba(250,250,247,.93);
  border-bottom:1px solid #e8ebe7;
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
}
.site-header-inner { min-height:78px; }
.site-desktop-nav a { font-weight:600; letter-spacing:0; }
.site-desktop-nav a.nav-is-active { background:#eaf3ec; color:#1c5b50; }
.site-join-button { border-radius:12px; background:#194d43; box-shadow:0 6px 18px rgba(27,79,65,.1); }
.site-join-button:hover { background:#126756; }
.preview-strip { background:#fff8e9; border-bottom:1px solid #f1e8d6; color:#775f41; }
.preview-strip a { color:#765732; }

/* Hero: intentional typographic rhythm. The functional search is primary. */
.home-hero { background:radial-gradient(ellipse at 81% 50%,#27574c 0,#193e38 43%,#112f2c 100%); }
.home-hero-inner { min-height:625px; }
.home-title { letter-spacing:-.072em; }
.home-title span { color:#e5f1bc; }
.home-kicker { color:#e5f1bd; border-color:rgba(229,241,189,.34); }
.home-search { border-radius:23px; box-shadow:0 22px 50px rgba(2,27,22,.19); }
.home-search-submit { background:#e7f4bd; }
.home-search-submit:hover { background:#d8ec9f; }
.home-hero-wave { height:34px; clip-path:polygon(0 60%,23% 76%,50% 43%,76% 71%,100% 41%,100% 100%,0 100%); }
.visual-main-card { transform:rotate(-5deg); border:1px solid rgba(255,255,255,.7); }
.visual-float-card { transform:rotate(5deg); }
.home-choice-section,.home-explore,.home-pro-section { max-width:1260px; }
.home-choice-section { padding-top:82px; padding-bottom:60px; }
.home-section-heading { margin-bottom:34px; }
.home-section-heading h2 { font-size:clamp(29px,3vw,42px); }
.choice-heading-note { color:#6f8179; font-size:14px; margin-top:9px; }
.section-marker { color:#688b7a; letter-spacing:.04em; font-size:12px; }

/* The supplied clinic and classroom photos are visible on the service cards. */
.choice-feature {
  isolation:isolate;
  min-height:320px;
  border-radius:29px;
  padding:28px 32px;
  background-position:center;
  background-size:cover;
  border:1px solid rgba(16,61,54,.07);
}
.choice-feature::before {
  content:'';
  position:absolute;
  inset:0;
  z-index:-1;
  background:linear-gradient(to left,rgba(250,253,253,.99) 0%,rgba(249,251,251,.97) 36%,rgba(249,251,251,.65) 63%,rgba(249,251,251,.08) 100%);
  transition:opacity .3s;
}
.choice-feature:hover::before { opacity:.86; }
.choice-doctor { background-image:url('/images/doctor-clinic.webp'); background-position:34% center; }
.choice-teacher { background-image:url('/images/teacher-classroom.webp'); background-position:34% center; }
.choice-top-line { display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative;z-index:2;color:#386b63; }
.choice-top-line svg { color:#4c827a; }
.choice-category-index { font-size:12px;font-weight:800;letter-spacing:.02em; }
.choice-inner { display:block; margin-top:auto; padding-top:35px; }
.choice-feature h3 { color:#173c36; font-size:clamp(28px,2.7vw,39px); margin:7px 0; }
.choice-feature p { color:#455e59; line-height:1.75; font-size:14px; }
.choice-overline { color:#437969; }
.choice-arrow { position:absolute;bottom:28px;left:28px;background:#1c564b;color:white;border-radius:16px; }
.choice-teacher .choice-arrow { background:#66538a; }
.choice-teacher .choice-overline,.choice-teacher .choice-category-index { color:#6a5688; }
.choice-decor { display:none; }
.home-flow { background:#eef4ed; padding:76px 30px; }
.flow-intro h2 { font-size:clamp(31px,3.3vw,45px); }
.flow-steps > div { border:1px solid #e6ebe4; background:#fff; box-shadow:0 10px 30px -26px rgba(19,56,42,.3); }
.flow-steps .flow-num { color:#789b87; }
.home-explore { padding-top:74px; }
.explore-panel { box-shadow:0 10px 35px -33px rgba(19,56,42,.3); }

/* Supplied green workspace photograph. Text remains on the natural empty right side. */
.home-pro-section { padding-top:20px; padding-bottom:72px; }
.home-pro-card {
  isolation:isolate;
  display:flex;
  justify-content:flex-start;
  align-items:center;
  min-height:355px;
  background:#e7f2d3 url('/images/professional-workspace.webp') center center / cover no-repeat;
  border:1px solid #e5eadc;
  border-radius:35px;
  padding:55px clamp(30px,5.5vw,75px);
}
.home-pro-card::before {
  content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(to left,rgba(239,248,222,.94) 0%,rgba(239,248,222,.89) 43%,rgba(239,248,222,.34) 73%,rgba(239,248,222,0) 100%);
}
.home-pro-copy { width:min(100%,680px);max-width:680px;position:relative;z-index:2; }
.home-pro-copy .pro-eyebrow { color:#3a6a4f;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.015em; }
.home-pro-copy .pro-eyebrow:before { content:'';display:block;width:22px;height:2px;background:#699a6e;border-radius:2px; }
.home-pro-copy h2 { font-size:clamp(28px,3.1vw,44px); line-height:1.48; letter-spacing:-.065em; margin:9px 0 10px; color:#173e35; }
.home-pro-copy p { color:#436954;font-size:14px;line-height:1.9;max-width:550px; }
.home-pro-actions { display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:28px; }
.home-pro-link { margin:0; border-radius:13px; background:#214f40; box-shadow:0 9px 25px -16px #214f40; font-size:14px; }
.home-pro-link:hover { background:#146e57; }
.pro-link-hint { display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:#356450; }
.home-pro-icon,.home-pro-scribble { display:none; }
.home-lower-note { padding-bottom:55px; }

/* Professional selection: the choice is visual, simple, and respectfully worded. */
.join-redesign { max-width:1270px; padding-top:66px; }
.join-intro .home-kicker { background:#edf5e9;color:#316650;border-color:#dceadd; }
.join-intro h1 { font-size:clamp(38px,4.7vw,62px);line-height:1.38; }
.join-intro h1 span { color:#3c7969; }
.join-intro p { color:#637c72; }
.join-options { gap:22px;margin-top:42px; }
.join-option {
  isolation:isolate;
  min-height:410px;
  border-radius:30px;
  padding:29px 31px 35px;
  border:1px solid #e0e9e4;
  background-size:cover;
  background-position:34% center;
  box-shadow:0 10px 32px -30px rgba(30,67,54,.35);
}
.join-option::before {
  content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(to left,rgba(251,253,252,.98) 0%,rgba(250,252,251,.90) 38%,rgba(249,253,252,.20) 100%);
}
.join-option-med { background-image:url('/images/doctor-clinic.webp'); }
.join-option-edu { background-image:url('/images/teacher-classroom.webp'); }
.join-option-tag { background:rgba(255,255,255,.87);color:#315f53;font-size:12px;border:1px solid rgba(39,96,72,.12);border-radius:80px;padding:8px 13px; }
.join-option-edu .join-option-tag { color:#655384; }
.join-option-bottom { align-items:flex-end; gap:14px; }
.join-option-bottom > div { max-width:350px; }
.join-option-bottom h2 { color:#173c36;font-size:clamp(38px,3.4vw,49px);margin-top:5px; }
.join-card-small { color:#53796a; font-size:12px;font-weight:700; }
.join-option-bottom p { color:#435e55;font-size:14px;max-width:275px;line-height:1.9;margin-top:9px; }
.join-option-arrow { width:50px;height:50px;flex:0 0 50px;border-radius:14px;background:#245749; }
.join-option-edu .join-option-arrow { background:#635284; }
.join-bottom-note { margin-top:32px; }
.join-option-pattern,.join-illustration,.join-med-bubble,.join-edu-bubble { display:none; }

/* Doctor / teacher search: real photography establishes context at first glance. */
.search-page .search-hero {
  isolation:isolate;
  background-color:#f1f7f6;
  background-size:cover;
  background-position:28% center;
  position:relative;
  min-height:315px;
}
.search-page .search-hero:before {
  content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(to left,rgba(251,253,252,.99) 0%,rgba(250,253,251,.97) 34%,rgba(247,251,250,.81) 57%,rgba(245,250,249,.15) 100%);
}
.search-doctor .search-hero { background-image:url('/images/doctor-clinic.webp'); }
.search-teacher .search-hero { background-image:url('/images/teacher-classroom.webp'); }
.search-hero-inner { padding-top:59px;padding-bottom:112px; }
.search-hero-inner > div:first-child { position:relative;z-index:2; }
.search-hero h1 { font-size:clamp(37px,4.15vw,56px);color:#183e37;letter-spacing:-.055em; }
.search-hero h1 em { color:#2b7460; }
.search-teacher .search-hero h1 em { color:#705d91; }
.search-hero p { color:#50685e;font-size:14px;max-width:430px;line-height:1.9; }
.search-hero-eyebrow { font-size:12px; color:#306d5c; }
.search-teacher .search-hero-eyebrow { color:#715e8f; }
.search-hero-decoration { display:none; }
.search-filter-panel { border:1px solid #e3eae5;box-shadow:0 25px 55px -42px rgba(22,59,47,.38);border-radius:22px;padding:24px 28px; }
.search-results-heading { margin-top:43px; }
.search-more-filters summary { color:#336c58; }
.search-page .directory-card { transition:transform .2s,box-shadow .2s; }
.search-page .directory-card:hover { transform:translateY(-3px);box-shadow:0 15px 35px -28px rgba(19,62,49,.25); }

/* Distinct professional dashboards: editorial imagery, not decorative gradients. */
.work-hero { isolation:isolate;min-height:235px;padding:36px 42px;background-size:cover;background-position:28% center;border:1px solid #e0e8df;border-radius:28px; }
.work-hero::before { content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(to left,rgba(250,252,248,.99) 0%,rgba(250,252,248,.94) 38%,rgba(250,252,248,.47) 68%,rgba(250,252,248,.04) 100%); }
.doctor-work-hero { background-image:url('/images/doctor-clinic.webp'); }
.teacher-work-hero { background-image:url('/images/teacher-classroom.webp'); }
.work-hero-label,.doctor-work-hero .work-hero-label { color:#2b7561; font-size:12px; }
.work-hero h1 { color:#153e35;font-size:clamp(28px,3vw,39px);line-height:1.4; }
.work-hero h1 span { color:#6aa28d; }
.work-hero p:not(.work-hero-label) { color:#516d62;font-size:13px; }
.work-hero .work-hero-art { display:none; }
.work-hero button { background:#1b5144; box-shadow:0 9px 18px -14px #204d44; }
.work-dashboard .work-stats > div { background:#fff!important;border:1px solid #e9ede6!important;box-shadow:0 12px 30px -28px rgba(0,0,0,.28)!important; }
.work-dashboard .work-stats > div:nth-child(1) { background:#ebf5e9!important; }
.work-dashboard .work-stats > div:nth-child(2) { background:#f6f2e9!important; }
.work-dashboard .work-stats > div:nth-child(3) { background:#eef0f7!important; }
.work-dashboard h2 { letter-spacing:-.025em; }

/* Professional profile photograph is a backdrop, never a substituted portrait. */
.profile-photo-head { isolation:isolate;position:relative; background-size:cover;background-position:31% center; }
.profile-photo-head::before { content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(105deg,rgba(22,49,45,.64),rgba(22,49,45,.73)); }
.doctor-profile-photo-head { background-image:url('/images/doctor-clinic.webp'); }
.teacher-profile-photo-head { background-image:url('/images/teacher-classroom.webp'); }
.profile-photo-head > * { position:relative;z-index:1; }
.profile-photo-head h1 { text-shadow:0 1px 5px rgba(0,0,0,.19); }

/* Additional refinement: accessible button hierarchy, calmer forms and metadata. */
.dawrak-app :is(input,select,textarea) { transition:border-color .16s,box-shadow .16s; }
.dawrak-app :is(input,select,textarea):focus-visible { outline:2px solid rgba(45,126,104,.35);outline-offset:1px; }
.dawrak-app :is(button,a) { -webkit-tap-highlight-color:transparent; }
.dawrak-app .shadow-soft { box-shadow:0 12px 40px -30px rgba(20,59,46,.25); }

@media(max-width:900px){
  .home-pro-card { background-position:40% center; }
  .home-pro-card::before { background:linear-gradient(to left,rgba(239,248,222,.98) 0%,rgba(239,248,222,.88) 55%,rgba(239,248,222,.16) 100%); }
  .work-hero { background-position:24% center; }
}
@media(max-width:780px){
  .home-choice-section { padding-top:58px; }
  .home-pro-card { padding:40px 30px;min-height:340px; }
  .home-pro-copy { max-width:500px; }
  .join-options { gap:17px; }
  .join-option { min-height:350px; }
  .search-page .search-hero { min-height:280px; }
  .search-hero-inner { padding:41px 25px 103px; }
  .search-page .search-hero:before { background:linear-gradient(to left,rgba(252,253,252,.99) 0%,rgba(252,253,252,.9) 58%,rgba(252,253,252,.36) 100%); }
}
@media(max-width:570px){
  .home-hero-inner { padding-top:65px; }
  .home-title { font-size:clamp(44px,12vw,58px); }
  .home-description { font-size:14px; }
  .choice-feature { min-height:275px; padding:23px; }
  .choice-feature::before { background:linear-gradient(to left,rgba(250,253,253,.98) 0%,rgba(250,253,253,.90) 58%,rgba(250,253,253,.30) 100%); }
  .choice-arrow { bottom:22px;left:22px;width:45px;height:45px;border-radius:13px; }
  .home-pro-card { min-height:385px;padding:35px 26px;background-position:35% center;align-items:flex-start; }
  .home-pro-card::before { background:linear-gradient(to left,rgba(239,248,222,.99) 0%,rgba(239,248,222,.96) 64%,rgba(239,248,222,.68) 100%); }
  .home-pro-copy h2 { font-size:28px; }
  .home-pro-actions { gap:14px; }
  .join-intro h1 { font-size:37px; }
  .join-option { min-height:310px; background-position:35% center;padding:22px; }
  .join-option::before { background:linear-gradient(to left,rgba(251,253,252,.99) 0%,rgba(251,253,252,.94) 56%,rgba(251,253,252,.4) 100%); }
  .join-option-bottom p { max-width:240px; }
  .search-hero h1 { font-size:36px; }
  .search-core-filters { grid-template-columns:1fr; }
  .search-extra-grid { grid-template-columns:1fr; }
  .search-hero-inner { padding-bottom:91px; }
  .search-body { margin-top:-43px; }
  .work-hero { min-height:220px;padding:25px;align-items:flex-start; }
  .work-hero:before { background:linear-gradient(to left,rgba(250,252,248,.98) 0%,rgba(250,252,248,.93) 68%,rgba(250,252,248,.54) 100%); }
  .work-hero h1 { font-size:27px; }
}

/* Shareable booking address is a product centerpiece, not a generic form. */
.share-studio { position:relative;overflow:hidden;display:flex;justify-content:space-between;gap:28px;border-radius:26px;border:1px solid #dfe8da;background:linear-gradient(115deg,#f0f6e8,#f5faf0 62%,#e7f1dc);padding:30px 35px; }
.share-studio-content { position:relative;z-index:2;max-width:730px;flex:1;min-width:0; }
.share-studio-eyebrow { display:inline-flex;gap:9px;align-items:center;color:#3e7963;font-size:12px;font-weight:700; }
.share-studio h2 { font-size:clamp(23px,2.7vw,31px);margin:8px 0 7px;color:#183e34;font-weight:800; }
.share-studio p { font-size:13px;color:#527569;line-height:1.8; }
.share-studio-url { display:flex;align-items:center;gap:8px;width:100%;max-width:630px;border:1px solid #d3e2d5;background:#fff;border-radius:14px;padding:7px 8px 7px 14px;margin-top:20px;box-shadow:0 9px 28px -22px #194f3c; }
.share-studio-url input { width:100%;min-width:0;flex:1;background:transparent;border:0;outline:0;font-size:13px;color:#31544a;padding:9px; }
.share-studio-url button { width:37px;height:37px;flex:0 0 37px;display:grid;place-items:center;border-radius:10px;background:#edf4e9;color:#23644c; }
.share-studio-url button:hover { background:#d7e9d7; }
.share-studio-feedback { display:block;color:#22664b;font-size:12px;margin-top:6px;font-weight:700; }
.share-studio-error { color:#9f6044!important;font-weight:700;margin-top:6px; }
.share-studio-actions { display:flex;gap:10px;flex-wrap:wrap;margin-top:15px; }
.share-studio-actions :is(a,button) { min-height:43px;display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:12px;font-weight:800;padding:10px 15px;border-radius:12px;transition:.2s; }
.share-studio-whatsapp { color:white;background:#1b604e; }
.share-studio-whatsapp:hover { background:#134b3e; }
.share-studio-visit { border:1px solid #d6e1d5;color:#315d4e;background:#fff; }
.share-studio-visit:hover { background:#eaf4e7; }
.share-studio-decor { display:flex;align-items:center;justify-content:space-between;flex-direction:column;position:relative;width:195px;flex:0 0 195px;background:#d7eab9;border-radius:22px;padding:20px 12px;transform:rotate(-5deg); }
.share-decor-top { font-family:'Alexandria',sans-serif;color:#295d49;font-weight:800; }
.share-decor-loop { font-family:'Alexandria',sans-serif;font-size:90px;line-height:1;color:#388266; }
.share-decor-bottom { font-size:11px;color:#4f7657;font-weight:700;text-align:center; }
/* Calm login experience with the same signature desk photo. */
.auth-aside { background:#edf4e0 url('/images/professional-workspace.webp') 25% center / cover no-repeat;isolation:isolate; }
.auth-aside:before { content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(to left,rgba(244,250,231,.96),rgba(244,250,231,.79) 74%,rgba(244,250,231,.34)); }
.auth-aside .auth-aside-art { display:none; }
.auth-aside h2 { color:#1e4a3d; }
.auth-aside p { color:#476d58; }
@media(max-width:760px){
  .share-studio { padding:25px 20px; }
  .share-studio-decor { display:none; }
}
/* The professional registration form inherits the correct visual context. */
.registration-banner { isolation:isolate;position:relative;overflow:hidden;border-radius:27px;min-height:228px;background-size:cover;background-position:25% center;display:flex;flex-direction:column;justify-content:center;padding:35px 39px;margin-bottom:24px; }
.registration-banner:before { content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(to left,rgba(249,252,249,.99),rgba(249,252,249,.90) 53%,rgba(249,252,249,.21)); }
.registration-banner-doctor { background-image:url('/images/doctor-clinic.webp'); }
.registration-banner-teacher { background-image:url('/images/teacher-classroom.webp'); }
.registration-banner > * { position:relative;z-index:2;max-width:500px; }
.registration-banner h1 { font-size:clamp(27px,3vw,36px);letter-spacing:-.035em; }
.registration-banner p:last-child { color:#587064;max-width:490px; }
.registration-form-card { border:1px solid #e6ebe4!important;border-radius:27px!important;background:#fff!important;box-shadow:0 15px 42px -36px rgba(0,0,0,.23); }
@media(max-width:570px){.registration-banner{min-height:210px;padding:26px;}.registration-banner:before{background:linear-gradient(to left,rgba(249,252,249,.97),rgba(249,252,249,.9) 70%,rgba(249,252,249,.45));}}


/* V4 — uninterrupted photographic hero, extending from the logo/navigation
   all the way to the hero's lower edge. Inner pages keep their own header. */
.home-cover-layout .site-header {
  position: absolute;
  inset: 0 0 auto;
  z-index: 50;
  background: transparent;
  border-bottom: 1px solid rgba(240, 252, 233, .18);
  box-shadow: none;
}
.home-cover-layout .site-header-inner { min-height: 84px; }
.home-cover-layout .new-brand-mark { color: #f8fff4; }
.home-cover-layout .brand-symbol { background: #e7f4bb; color: #123d32; }
.home-cover-layout .brand-symbol i { border-color: #f8fff4; }
.home-cover-layout .site-desktop-nav a { color: #f0f8ef; }
.home-cover-layout .site-desktop-nav a:hover,
.home-cover-layout .site-desktop-nav a.nav-is-active {
  color: #f7ffe8;
  background: rgba(255,255,255,.13);
}
.home-cover-layout .site-login { color: #f3fff5; }
.home-cover-layout .site-login:hover { color: #e7f4bb; }
.home-cover-layout .site-join-button { background: #e9f5bd; color: #15392f; }
.home-cover-layout .site-join-button:hover { background: #f4ffd9; }
.home-cover-layout .site-mobile-trigger { color: #f8fff3; background: rgba(255,255,255,.10); }
.home-cover-layout .site-mobile-menu {
  background: rgba(13, 47, 38, .98);
  border-top: 1px solid rgba(255,255,255,.18);
  color: #f9fff6;
}
.home-cover-layout .site-mobile-menu a,
.home-cover-layout .site-mobile-menu button { color: #f8fff4; }
.home-cover-layout .site-mobile-menu .nav-is-active { background: rgba(255,255,255,.15); }
.home-cover-layout .home-hero {
  background-color: #0d4133;
  background-image:
    linear-gradient(90deg, rgba(7,39,31,.09) 0%, rgba(7,39,31,.13) 35%, rgba(7,39,31,.26) 68%, rgba(7,39,31,.33) 100%),
    url('/images/home-hero-forest.webp');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
}
.home-cover-layout .home-hero-inner {
  min-height: 790px;
  padding-top: 160px;
  padding-bottom: 125px;
}
/* The supplied photo already has its own light, foliage, books and calendar. */
.home-cover-layout .home-hero-doodle { display: none; }
.home-cover-layout .home-description { color: #f1f9f1; text-shadow: 0 2px 12px rgba(0,0,0,.22); }
.home-cover-layout .home-hero-shortcut { color: #d6eade; }
.home-cover-layout .home-hero-shortcut a { color: #ecffb2; }
.home-cover-layout .home-kicker { background: rgba(5,38,30,.28); border-color: rgba(232,249,204,.3); }
.home-cover-layout .home-search { box-shadow: 0 25px 65px rgba(4,33,26,.28); }
.home-preview-note { margin: 12px 0 0; color: rgba(235,248,229,.83); font-size: 11px; line-height: 1.8; }
.home-cover-layout .visual-orbit { border-color: rgba(218, 244, 178, .27); }
.home-cover-layout .visual-float-card { border-color: rgba(19,63,51,.87); }
@media (max-width:1050px) {
  .home-cover-layout .home-hero-inner { min-height: 730px; padding-top: 137px; padding-bottom: 115px; }
}
@media (max-width:780px) {
  .home-cover-layout .site-header-inner { min-height: 72px; }
  .home-cover-layout .home-hero {
    background-position: 49% center;
    background-image:
      linear-gradient(180deg, rgba(6,39,31,.30), rgba(6,39,31,.17) 40%, rgba(6,39,31,.28)),
      url('/images/home-hero-forest.webp');
  }
  .home-cover-layout .home-hero-inner {
    min-height: 675px;
    display: flex;
    flex-direction: column;
    padding: 146px 24px 100px;
    justify-content: center;
  }
  /* On smaller screens let the user's photograph breathe and keep booking above the fold. */
  .home-cover-layout .home-visual { display:none; }
  .home-cover-layout .home-hero-content { width: 100%; }
  .home-cover-layout .home-search { max-width: 640px; }
  .home-cover-layout .home-title { font-size: clamp(44px,8.4vw,66px); }
}
@media (max-width:570px) {
  .home-cover-layout .home-hero { background-position: 48% center; }
  .home-cover-layout .home-hero-inner { min-height: 670px; padding: 114px 18px 88px; }
  .home-cover-layout .home-title { font-size: clamp(43px,10.8vw,54px); }
  .home-cover-layout .home-description { font-size: 14px; }
  .home-cover-layout .home-search { border-radius: 21px; }
  .home-cover-layout .home-hero-shortcut { align-items:flex-start; flex-wrap:wrap; }
  .home-cover-layout .home-preview-note { font-size:10px; }
}


/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   V5 / DAWRAK PALETTE & PRODUCT POLISH
   One connected colour language; meaningful healthcare / education
   accents. The photographic homepage hero and transparent nav are
   preserved exactly as in V4.
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
:root {
  --forest-950:#0C3029;
  --forest-900:#123F35;
  --forest-700:#206754;
  --forest-500:#39856D;
  --sage-100:#EEF6EF;
  --sage-200:#DFECE1;
  --cream-50:#FAFAF7;
  --paper-100:#F3F5F0;
  --ink-900:#173B33;
  --ink-700:#365549;
  --ink-500:#657B70;
  --iris-700:#5E4685;
  --iris-500:#8C71B4;
  --iris-100:#F5F2FA;
  --iris-200:#DFD3EF;
  --sky-700:#225E67;
  --sky-100:#EFF8F8;
  --mist:#E5EAE4;
  --accent:#206754;
  --accent-bg:#EEF6EF;
  --accent-border:#C5DDCD;
  color-scheme:light;
}
.dawrak-app.experience-education { --accent:#755A9D; --accent-bg:#F5F2FA; --accent-border:#DFD3EF; }
.dawrak-app.experience-healthcare { --accent:#206754; --accent-bg:#EFF8F8; --accent-border:#BFDEE1; }
.dawrak-app.experience-admin { --accent:#265C50; --accent-bg:#F0F4ED; --accent-border:#CCDCD1; }
.dawrak-app:not(.home-cover-layout) { background:var(--cream-50); }
.dawrak-app :is(input,select,textarea) { color:var(--ink-900); accent-color:var(--accent); }
.dawrak-app :is(input,select,textarea)::placeholder { color:#82958A; }
.dawrak-app :is(button,a,[role="button"]) { transition:background-color .19s ease,color .19s ease,border-color .19s ease,box-shadow .19s ease,transform .19s ease; }
.dawrak-app :is(button,a):focus-visible { outline:3px solid #80AA8C; outline-offset:3px; }
.dawrak-app .experience-accent { color:var(--accent); }
.dawrak-app .experience-accent-bg { background:var(--accent-bg); }
/* Primary actions have sufficient contrast and consistent feedback. */
.dawrak-app .bg-brand-600 { background-color:#206754; }
.dawrak-app .hover\:bg-brand-700:hover { background-color:#154B3E; }
.dawrak-app .bg-brand-700 { background-color:#185747; }
.dawrak-app .bg-edu-600 { background-color:#755A9D; }
.dawrak-app .hover\:bg-edu-700:hover { background-color:#5E4685; }
.dawrak-app .text-brand-700 { color:#185747; }
.dawrak-app .text-edu-700 { color:#5E4685; }
.dawrak-app .bg-edu-50 { background-color:#F5F2FA; }
.dawrak-app .bg-brand-50 { background-color:#EEF6EF; }
.dawrak-app .text-ink-900 { color:#173B33; }
.dawrak-app .text-ink-500 { color:#657B70; }
.dawrak-app .text-ink-400 { color:#829A8E; }
.dawrak-app .text-ink-600 { color:#4C675C; }
.dawrak-app .text-ink-700 { color:#365549; }
.dawrak-app .border-ink-100 { border-color:#E5EAE4; }
.dawrak-app .border-ink-200 { border-color:#CCD8D1; }
.dawrak-app .bg-ink-50 { background-color:#F3F6F1; }
.dawrak-app .bg-ink-100 { background-color:#E5EAE4; }
.dawrak-app .bg-white { background-color:#FFFEFC; }
.dawrak-app .rounded-xl { border-radius:14px; }
.dawrak-app .rounded-2xl { border-radius:21px; }
.dawrak-app .rounded-3xl { border-radius:27px; }
.dawrak-app .shadow-soft { box-shadow:0 2px 3px rgba(19,63,53,.025),0 18px 44px -33px rgba(19,63,53,.24); }
.dawrak-app .shadow-lift { box-shadow:0 4px 9px rgba(19,63,53,.045),0 30px 55px -28px rgba(19,63,53,.28); }
/* Subtle visual signature on inner pages. Hero background is intentionally untouched. */
.dawrak-app:not(.home-cover-layout) main { background:radial-gradient(ellipse 560px 310px at 90% 0%,rgba(224,237,220,.18),transparent 86%),var(--cream-50); }
.dawrak-app.experience-education main { background:radial-gradient(ellipse 560px 300px at 93% 0%,rgba(223,211,239,.16),transparent 84%),var(--cream-50); }
.dawrak-app .site-header { border-bottom-color:rgba(23,59,51,.09); }
.dawrak-app:not(.home-cover-layout) .site-header { background:rgba(250,250,247,.97); }
.dawrak-app .new-brand-mark { letter-spacing:-.02em; }
.dawrak-app:not(.home-cover-layout) .brand-symbol { background:#123F35; color:#E7F4BD; }
.dawrak-app .site-desktop-nav a { color:#4F675D; }
.dawrak-app .site-desktop-nav a:hover,.dawrak-app .site-desktop-nav a.nav-is-active { background:#EAF2EB; color:#174D3E; }
.dawrak-app .site-login:hover { color:#206754; }
.dawrak-app .site-join-button { background:#184F42; color:#fff; }
.dawrak-app .site-join-button:hover { background:#206754; box-shadow:0 11px 25px -15px rgba(19,63,53,.35); }
/* Homepage header rules must come last — keep V4 photographic treatment. */
.dawrak-app.home-cover-layout .site-header { background:transparent; border-bottom:1px solid rgba(240,252,233,.18); }
.dawrak-app.home-cover-layout .site-desktop-nav a { color:#F0F8EF; }
.dawrak-app.home-cover-layout .site-desktop-nav a:hover,.dawrak-app.home-cover-layout .site-desktop-nav a.nav-is-active { background:rgba(255,255,255,.13);color:#F7FFE8; }
.dawrak-app.home-cover-layout .site-login,.dawrak-app.home-cover-layout .new-brand-mark { color:#F8FFF3; }
.dawrak-app.home-cover-layout .site-join-button { background:#E9F5BD; color:#15392F; }
.dawrak-app.home-cover-layout .site-join-button:hover { background:#F4FFD9; }
.dawrak-app.home-cover-layout .brand-symbol { background:#E7F4BD; color:#123D32; }
/* Inner page section rhythm: deliberate gaps, thin strokes, luminous surfaces. */
.dawrak-app:not(.home-cover-layout) main .shadow-soft { border-color:var(--mist); }
.dawrak-app:not(.home-cover-layout) main .shadow-soft:hover { border-color:#D5E1D7; }
.dawrak-app :is(.search-filter-panel,.directory-card,.share-studio,.registration-form-card,.auth-form-side,.demo-action-panel) { box-shadow:0 16px 46px -37px rgba(19,63,53,.29); }
.dawrak-app :is(.search-filter-panel,.directory-card,.share-studio,.registration-form-card,.auth-form-side,.demo-action-panel) { border-color:#E2EAE3; }
.dawrak-app .search-filter-panel input,.dawrak-app .search-filter-panel select { background:#FBFCF9; border-color:#DBE5DD; }
.dawrak-app .search-filter-panel :is(input,select):focus { border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg); }
.search-core-filters :is(input,select) { min-height:47px; }
.dawrak-app .search-results-heading h2 span { color:#33846A; }
.dawrak-app.experience-education .search-results-heading h2 span { color:#755A9D; }
.search-results-heading > span { background:#EAF2EB; color:#365549; }
.dawrak-app .directory-card { background:#FFFEFC; border-radius:24px; }
.dawrak-app .directory-card-stripe { background:#E4F1F0; color:#225E67; }
.dawrak-app .teacher-directory-card .directory-card-stripe { background:#EDE6F4; color:#5E4685; }
.dawrak-app .directory-card:hover { border-color:var(--accent-border);box-shadow:0 24px 42px -31px rgba(19,63,53,.3); }
.dawrak-app .directory-info-lines b { color:var(--ink-900); }
.dawrak-app .directory-cta { border-top-color:#DAE5DD; color:var(--accent); }
.dawrak-app .directory-cta > span { background:var(--accent-bg); color:var(--accent); }
.dawrak-app .directory-cta:hover > span { background:var(--accent-border); }
/* Distinct patient booking and student-group accents — calm, not neon. */
.dawrak-app.experience-education .bg-brand-600:not(.site-join-button) { background-color:#755A9D; }
.dawrak-app.experience-education .hover\:bg-brand-700:hover { background-color:#5E4685; }
.dawrak-app.experience-education .border-brand-200 { border-color:#DFD3EF; }
.dawrak-app.experience-education .bg-brand-50 { background-color:#F5F2FA; }
.dawrak-app.experience-education .text-brand-700 { color:#5E4685; }
.dawrak-app.experience-education .text-brand-600 { color:#755A9D; }
.dawrak-app.experience-education .ring-brand-200 { --tw-ring-color:#DFD3EF; }
.dawrak-app .seat-open { background:#E8F3E5; color:#276647!important; }
.dawrak-app .seat-full { background:#FCF0EA; color:#935A4B!important; }
.dawrak-app .work-hero { border-color:#E0EAE0; }
.dawrak-app .work-hero:before { background:linear-gradient(to left,rgba(251,252,247,.99),rgba(251,252,247,.92) 42%,rgba(251,252,247,.39) 72%,rgba(251,252,247,.05)); }
.dawrak-app .work-hero h1 { color:#173B33; }
.dawrak-app .work-hero-label,.dawrak-app .doctor-work-hero .work-hero-label { color:#206754; }
.dawrak-app.experience-education .work-hero-label { color:#755A9D; }
.dawrak-app .work-hero h1 span { color:#8C71B4; }
.dawrak-app .doctor-work-hero h1 span { color:#39856D; }
.dawrak-app .work-stats > div:nth-child(1) { background:#EAF5EA!important; }
.dawrak-app .work-stats > div:nth-child(2) { background:#FAF4E9!important; }
.dawrak-app .work-stats > div:nth-child(3) { background:#F0EDF8!important; }
.dawrak-app.experience-healthcare .work-stats > div:nth-child(3) { background:#EAF2F6!important; }
.dawrak-app .work-group-card { border-color:#E4EAE3!important; }
.dawrak-app .work-group-card:before { background:#A790C8; height:4px; }
.dawrak-app .work-group-card:focus-within { outline:2px solid #B9A7D0; outline-offset:3px; }
.dawrak-app .work-group-card .bg-edu-500 { background:#8C71B4; }
.dawrak-app .share-studio { background:linear-gradient(120deg,#EFF5E9,#F9FBF4 58%,#E6F0DE); border-color:#DCE7DB; }
.dawrak-app.experience-education .share-studio { background:linear-gradient(120deg,#F1EDF7,#FBFAFD 58%,#E9E1F3);border-color:#E2D8ED; }
.dawrak-app.experience-education .share-studio-decor { background:#DFD3EF; }
.dawrak-app.experience-education .share-decor-loop { color:#755A9D; }
.dawrak-app .share-studio-whatsapp { background:#206754; }
.dawrak-app .share-studio-whatsapp:hover { background:#174D40; }
.dawrak-app .share-studio-url { border-color:#D3E0D5; }
/* Review of status colours: legible in Arabic small type. */
.dawrak-app [role="status"] { line-height:1.75; }
.dawrak-app .demo-ticket { background:#E6DDF2; }
.dawrak-app .demo-progress > span { background:#755A9D; }
.dawrak-app .demo-action-panel { background:#FFFEFC; }
.dawrak-app .demo-paths a { background:#EEF3EC; }
.dawrak-app .demo-paths a:hover { background:#E2EDE1; }
.dawrak-app .auth-form-side { background:#FFFEFC; }
.dawrak-app .auth-form-card button[type=submit] { background:#206754; }
.dawrak-app .auth-form-card button[type=submit]:hover { background:#185747; }
.dawrak-app .registration-form-card { background:#FFFEFC!important; }
.dawrak-app .registration-banner:before { background:linear-gradient(to left,rgba(251,252,247,.99),rgba(251,252,247,.91) 48%,rgba(251,252,247,.2)); }
/* Unified footer: designed continuation of the content, not a heavy bar. */
.dawrak-app .site-footer { background:#F0F3EB; border-top-color:#E1E9DF; }
.dawrak-app .site-footer-inner > span { color:#647A6E; }
.dawrak-app .site-footer-inner > div a { color:#365549; }
.dawrak-app .site-footer-inner > div a:hover { color:#206754; }
@media(max-width:780px) {
 .dawrak-app .site-mobile-menu { box-shadow:0 15px 24px -20px rgba(10,48,39,.25); }
 .dawrak-app:not(.home-cover-layout) .site-mobile-menu { background:#FFFEFC; }
 .dawrak-app.home-cover-layout .site-mobile-menu { background:rgba(13,47,38,.98); }
 .dawrak-app .work-hero::before { background:linear-gradient(to left,rgba(251,252,247,.99),rgba(251,252,247,.95) 67%,rgba(251,252,247,.53)); }
}
@media(prefers-reduced-motion:reduce) {
 .dawrak-app :is(button,a,[role="button"]) { transition:none; }
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   V6 / THE DAWRAK SIGNATURE
   A quieter, more expressive product experience. The photographic
   homepage hero, top navigation, and Supabase logic remain unchanged.
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
:root {
  --dawrak-vanilla:#FFFDF7;
  --dawrak-ivory:#F8F8F3;
  --dawrak-leaf:#D9E9CC;
  --dawrak-gold:#D0A46C;
}
/* A rhythm of deliberate whitespace, not rows of template cards. */
.dawrak-app .home-choice-section { padding-top:94px; padding-bottom:95px; }
.dawrak-app .home-section-heading { margin-bottom:37px; }
.dawrak-app .home-section-heading h2 { max-width:810px; margin-inline:auto; }
.dawrak-app .choice-feature { border:1px solid rgba(255,255,255,.82); box-shadow:0 2px 2px rgba(15,51,39,.03),0 20px 50px -39px rgba(12,48,41,.28); }
.dawrak-app .choice-feature:focus-visible { outline:3px solid #8FB6A2; outline-offset:4px; }
.dawrak-app .choice-top-line { width:100%; }
.dawrak-app .choice-top-line > svg { background:rgba(255,255,255,.75);border-radius:13px;padding:8px;width:39px;height:39px; }
.dawrak-app .choice-overline { display:block; letter-spacing:.005em; }
.dawrak-app .choice-category-index { font-family:'IBM Plex Sans Arabic',sans-serif;font-size:12px; }
.dawrak-app .choice-arrow { box-shadow:0 8px 22px -15px rgba(12,48,41,.5); }
@media(hover:hover){
  .dawrak-app .choice-feature:hover .choice-arrow { transform:translate(-3px,-3px) rotate(-8deg); }
  .dawrak-app .choice-feature:hover h3 { color:#146950; }
  .dawrak-app .choice-teacher:hover h3 { color:#6B4F8E; }
}
/* Editorial three-step flow: fine connecting line, not another dashboard. */
.dawrak-app .home-flow { background:#F1F4EE; padding-block:88px; position:relative; }
.dawrak-app .home-flow::before { content:''; position:absolute; inset:0; opacity:.23; pointer-events:none; background-image:radial-gradient(#9DB3A2 .7px, transparent .7px);background-size:17px 17px;mask-image:linear-gradient(to left,black,transparent 70%); }
.dawrak-app .home-flow-inner { position:relative; z-index:1; }
.dawrak-app .flow-steps { position:relative; gap:12px; }
.dawrak-app .flow-steps::before { content:'';position:absolute;top:35px;right:45px;left:45px;border-top:2px dashed #B9CAB9;z-index:0; }
.dawrak-app .flow-steps > div { background:rgba(255,253,248,.9); min-height:178px; border:1px solid #E6EBE0; box-shadow:0 14px 30px -31px rgba(24,63,49,.3); }
.dawrak-app .flow-steps svg { background:#EDF6EA;border-radius:13px;padding:8px;width:43px;height:43px; }
.dawrak-app .flow-steps > div:nth-child(2) svg { background:#F1EBF7; color:#76599C; }
.dawrak-app .flow-steps > div:nth-child(3) svg { background:#FFF0E5; color:#A06D4A; }
.dawrak-app .flow-num { font-size:13px; }

/* A distinctive interactive peek into real product use-cases. All figures
   are deliberately labelled as illustrative; no fake live bookings. */
.home-product-section { max-width:1330px; margin:0 auto; padding:105px 34px 82px; }
.home-product-heading { display:flex; align-items:end; justify-content:space-between; gap:25px; max-width:1250px; margin:0 auto 35px; }
.home-product-heading .section-marker { display:inline-flex; align-items:center; gap:9px; }
.home-product-heading .section-marker > span { color:#B48B55; font-size:19px; }
.home-product-heading h2 { font-size:clamp(31px,3.35vw,48px); font-weight:800; letter-spacing:-.06em; line-height:1.4; margin-top:10px; }
.home-product-heading h2 span { color:#34806A; }
.home-product-heading > p { color:#788D7F; font-size:14px; padding-bottom:7px; }
.product-lens { direction:rtl; display:grid;grid-template-columns:.95fr 1.05fr; border:1px solid #E4EAE0; border-radius:38px; overflow:hidden; min-height:510px; background:#F5F5ED; box-shadow:0 27px 64px -49px rgba(18,61,44,.22); }
.lens-copy { padding:48px clamp(30px,4vw,65px); display:flex;flex-direction:column;align-items:flex-start;position:relative;z-index:2; }
.lens-copy::before { content:'✳';position:absolute;left:30px;bottom:13px;font-size:110px;font-weight:200;color:#DCE9D5;opacity:.62;pointer-events:none;transform:rotate(18deg); }
.lens-switch { display:inline-flex; background:#E6EDE1; padding:5px; gap:5px; border-radius:16px; margin-bottom:49px; }
.lens-switch button { display:flex;align-items:center;justify-content:center;gap:8px;padding:10px 20px;border-radius:12px;color:#5A7565;font-weight:800;font-size:13px;min-height:43px; }
.lens-switch button.is-selected { background:#FFFFFF;box-shadow:0 3px 10px -7px #285F4E;color:#235749; }
.lens-switch button:hover:not(.is-selected) { background:#F0F5EC; }
.lens-kicker { display:inline-block;color:#527966;font-size:13px;font-weight:700; }
.lens-text { animation:fade-up .34s ease both; }
.lens-text h3 { font-size:clamp(31px,3vw,47px);line-height:1.35;margin-top:11px;color:#173F35;font-weight:800; }
.lens-text p { font-size:15px;line-height:2;max-width:365px;color:#5E776A;margin-top:16px; }
.lens-benefits { display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:27px 0 28px;color:#436453; }
.lens-benefits span { display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:12px; }
.lens-benefits svg { color:#2F8A69; }
.lens-action { display:inline-flex;align-items:center;justify-content:space-between;gap:32px;padding:15px 19px 15px 15px;border-radius:15px;background:#174C3C;color:#F9FFF6;font-weight:800;font-size:14px;position:relative;z-index:1; }
.lens-action:hover { background:#23684F;transform:translateY(-2px);box-shadow:0 12px 23px -15px #174C3C; }
.lens-visual { position:relative;min-height:510px;isolation:isolate;overflow:hidden;background:#D9E5D7; }
.lens-photo { position:absolute;inset:0;z-index:-2;background:url('/images/teacher-classroom.webp') 30% center / cover no-repeat;filter:saturate(.75);transition:opacity .3s; }
.product-lens-doctor .lens-photo { background-image:url('/images/doctor-clinic.webp');background-position:30% center; }
.lens-visual::before { content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(145deg,rgba(19,70,52,.10),rgba(19,70,52,.16) 40%,rgba(11,50,40,.43)); }
.product-lens-teacher .lens-visual::before { background:linear-gradient(145deg,rgba(65,44,88,.07),rgba(32,36,66,.18) 43%,rgba(35,31,63,.43)); }
.lens-stamp { position:absolute;top:30px;left:30px;display:flex;align-items:center;gap:9px;color:#1E4B3E;background:#F9FFF2E8;backdrop-filter:blur(9px);border:1px solid #FFFFFFB8;padding:7px 12px;border-radius:50px;font-weight:800;font-size:13px; }
.lens-stamp > span:last-child { color:#A16D49; }
.lens-ticket { position:absolute;bottom:48px;left:50%;width:min(355px,80%);transform:translateX(-50%) rotate(-3deg);padding:25px 28px;background:#FFFFFCEE;border:1px solid rgba(255,255,255,.86);backdrop-filter:blur(12px);box-shadow:0 26px 55px -32px #082F25B8;border-radius:25px;color:#234C3E; }
.lens-ticket::after { content:'';position:absolute;bottom:-13px;right:17px;left:17px;border-radius:0 0 17px 17px;height:15px;background:#D5E4D7B5;z-index:-1; }
.lens-ticket-head { font-size:12px;font-weight:800;color:#769483;display:flex;align-items:center;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid #E5ECE3; }
.lens-ticket-dots {font-size:8px;letter-spacing:4px;color:#9CBCA1;}
.lens-ticket-title { display:flex;align-items:center;gap:9px;margin:18px 0;font-size:17px; }
.lens-ticket-title svg { color:#408A6C; }
.lens-group-title { display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px; }
.lens-group-title > span { font-weight:700; }
.lens-group-title > b { font-size:10px;font-weight:600;color:#876CA4;background:#F2EBF8;padding:6px 9px;border-radius:60px; }
.lens-seat-number { display:flex;align-items:end;justify-content:space-between;gap:10px;margin-top:23px; }
.lens-seat-number strong { font-family:'Alexandria',sans-serif;font-size:45px;line-height:1.2;letter-spacing:-.075em; }
.lens-seat-number strong small { font-size:18px;color:#8AA094; }
.lens-seat-number > span { font-size:12px;color:#48816C;font-weight:800;padding-bottom:7px; }
.lens-seat-bar { height:10px;border-radius:60px;background:#E6EEE5;overflow:hidden;margin-top:17px; }
.lens-seat-bar span { display:block;width:90%;height:100%;border-radius:inherit;background:linear-gradient(to left,#B7A3D1,#8264A4); }
.lens-group-foot { display:flex;align-items:center;gap:7px;margin-top:16px;font-size:11px;color:#789383; }
.lens-timeline { margin:15px 0 5px;display:grid;gap:11px; }
.lens-timeline > div { display:flex;align-items:center;gap:14px;background:#F4F8F3;padding:10px 12px;border-radius:12px; }
.lens-timeline span { font-size:13px;font-weight:800;direction:ltr; }
.lens-timeline b { font-size:12px;font-weight:600;flex:1; }
.lens-timeline i { background:#72AA8D;width:9px;height:9px;border-radius:50%; }
.lens-timeline > div:nth-child(2) i { background:#E4B372; }
.lens-timeline > div:nth-child(3) i { background:#B7C9BE; }
.lens-share-note { position:absolute;bottom:27px;right:28px;display:inline-flex;align-items:center;gap:8px;padding:13px 17px;border-radius:16px;color:#1C4D3A;font-size:12px;font-weight:800;background:#E4F4D3;box-shadow:0 18px 33px -23px #102B23;transform:rotate(4deg); }
.lens-share-note svg:last-child { background:#2C7659;border-radius:50%;padding:2px;color:#FFF; }
.lens-disclaimer {font-size:11px;color:#8B9B91;text-align:center;padding:14px 10px 0;}
.product-lens-teacher .lens-switch button.is-selected { color:#665080; }
.product-lens-teacher .lens-action { background:#675284; }
.product-lens-teacher .lens-action:hover { background:#7B6598; }
.product-lens-teacher .lens-benefits svg { color:#8067A5; }
.product-lens-teacher .lens-text h3 { color:#413350; }
.product-lens-teacher .lens-copy::before { color:#E3D9EA; }
/* Inside the app: subtly tactile but never crowded. */
.dawrak-app:not(.home-cover-layout) main { background-color:var(--dawrak-ivory); }
.dawrak-app :is(.search-filter-panel,.registration-form-card,.auth-form-card) { border-radius:27px; }
.dawrak-app :is(.directory-card,.work-group-card) { transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease; }
.dawrak-app .directory-card-stripe { position:relative; }
.dawrak-app .directory-card-stripe::after { content:'';position:absolute;bottom:0;inset-inline-start:17px;inset-inline-end:17px;border-bottom:1px solid rgba(255,255,255,.55); }
.dawrak-app .directory-avatar { border:3px solid #fff;box-shadow:0 7px 17px -15px #294F3D; }
.dawrak-app .directory-card:hover .directory-cta > span { transform:translate(-2px,-2px) rotate(-8deg); }
.dawrak-app .work-stats > div { transition:transform .2s ease,box-shadow .2s ease; }
@media(hover:hover){ .dawrak-app .work-stats > div:hover { transform:translateY(-3px);box-shadow:0 13px 26px -27px #295F4D!important; } }
.dawrak-app .work-group-card { padding:25px!important; }
.dawrak-app .work-group-card:before { right:25px;left:25px;top:0;height:4px;border-radius:0 0 5px 5px;background:linear-gradient(to left,#8A70AB,#BDAAE0); }
.dawrak-app .work-group-card .h-2 { height:9px;border-radius:40px; }
.dawrak-app .work-group-card .h-2 > div { border-radius:40px; }
.dawrak-app .work-group-card button { min-height:39px; }
.dawrak-app .work-hero { box-shadow:0 16px 38px -33px #174D3D; }
/* A recognizable closing note, rather than a generic site footer. */
.dawrak-app .site-footer { border-top:1px solid #DEE8DF;background:#EFF3EB; }
.dawrak-app .site-footer-inner { min-height:145px; }
.dawrak-app .site-footer-inner > span { color:#597367;letter-spacing:.015em; }
.dawrak-app .site-footer-inner > div { flex-wrap:wrap;gap:17px; }
.dawrak-app .site-footer-inner > div a { text-decoration:none;text-underline-offset:5px; }
.dawrak-app .site-footer-inner > div a:hover { text-decoration:underline; }
/* Mobile composition remains thumb-friendly and readable. */
@media(max-width:950px){
  .home-product-section { padding:72px 22px 66px; }
  .product-lens { grid-template-columns:1fr 1fr; }
  .lens-copy { padding:35px 30px; }
  .lens-switch { margin-bottom:30px; }
  .lens-visual { min-height:485px; }
  .lens-ticket { width:min(335px,87%);padding:21px; }
  .lens-share-note { right:12px;bottom:15px; }
}
@media(max-width:780px){
  .dawrak-app .home-choice-section { padding-top:64px;padding-bottom:69px; }
  .dawrak-app .home-flow { padding-block:58px; }
  .dawrak-app .flow-steps::before { display:none; }
  .home-product-heading { align-items:flex-start;flex-direction:column;gap:8px; }
  .home-product-heading h2 { font-size:clamp(30px,5.8vw,43px); }
  .product-lens { grid-template-columns:1fr; }
  .lens-copy { min-height:405px;padding:34px 32px 38px; }
  .lens-switch { margin-bottom:26px; }
  .lens-copy::before { left:24px;bottom:-20px; }
  .lens-text p { max-width:100%; }
  .lens-visual { min-height:400px; }
  .lens-photo { background-position:30% 46%; }
  .lens-ticket { bottom:35px;width:min(355px,80%); }
  .lens-share-note { bottom:19px;right:19px; }
}
@media(max-width:570px){
  .home-product-section { padding:60px 18px 53px; }
  .home-product-heading h2 { font-size:31px; }
  .home-product-heading > p { font-size:12px; }
  .product-lens { border-radius:26px; }
  .lens-copy { min-height:0;padding:24px 24px 30px; }
  .lens-switch { width:100%; }
  .lens-switch button { flex:1;padding-inline:8px; }
  .lens-text h3 { font-size:31px; }
  .lens-text p { font-size:14px;line-height:1.9; }
  .lens-benefits { gap:8px;margin-block:19px 23px; }
  .lens-visual { min-height:345px; }
  .lens-ticket { bottom:30px;width:min(310px,85%);padding:16px 19px; }
  .lens-ticket-title { margin:12px 0; }
  .lens-seat-number { margin-top:10px; }
  .lens-seat-number strong { font-size:37px; }
  .lens-share-note { padding:9px 12px;font-size:11px;right:9px;bottom:14px; }
  .lens-stamp { left:16px;top:16px; }
  .dawrak-app .site-footer-inner { min-height:auto;padding-block:30px; }
}
@media(prefers-reduced-motion:reduce){
  .lens-text { animation:none; }
  .dawrak-app .work-stats > div,.dawrak-app .choice-feature,.dawrak-app .directory-card { transition:none; }
  .dawrak-app :is(.choice-feature,.directory-card,.work-stats > div):hover { transform:none; }
}

/* V7 — footer logo stays forest green on the light footer, while
   the homepage header logo stays white over the photographic hero. */
.dawrak-app .site-footer .new-brand-mark {
  color: #175B48;
}

/* V8 — a clear, understated identity for the platform owner. */
.dawrak-app .admin-account-pill {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .45rem .75rem; border: 1px solid rgba(23,91,72,.18);
  border-radius: 999px; color: #175b48; background: #eaf4ed;
  font-size: .77rem; font-weight: 750; white-space: nowrap;
}
@media (max-width: 820px) { .dawrak-app .admin-account-pill { display: none; } }
/* V9: distinct workspaces and calm, distraction-free public booking */
.dawrak-app.workspace-layout:not(.home-cover-layout) .site-header {
  background: rgba(253, 253, 249, 0.96);
  border-bottom: 1px solid rgba(24, 88, 70, .09);
  backdrop-filter: blur(16px);
}
.dawrak-app .workspace-context {
  display: inline-flex; align-items: center; gap: 7px; color: #296450;
  background: #e9f3ec; border: 1px solid #d6e8d9; border-radius: 999px;
  font-size: 12px; padding: 8px 12px; font-weight: 700;
}
.dawrak-app.direct-booking-layout .site-header-inner { max-width: 1160px; }
.dawrak-app.direct-booking-layout .site-desktop-nav { margin-inline: auto; }
.dawrak-app.direct-booking-layout .site-header-actions .site-join-button { display: none; }
.dawrak-app .direct-booking-footnote {
  padding: 19px 16px 25px; text-align: center; font-size: 12px; color: #557367;
  background: #f6faf6; border-top: 1px solid #e3ebe5;
}
@media (max-width: 750px) {
  .dawrak-app .workspace-context { display: none; }
  .dawrak-app.direct-booking-layout .site-header-inner { min-height: 72px; }
}

/* V12 — Stable, readable doctor and teacher dashboard metrics. */
.dawrak-app .work-dashboard .work-stats .work-stat-card {
  min-height: 126px;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 15px;
  padding: 20px 22px;
  overflow: hidden;
}
.dawrak-app .work-stats .work-stat-card__icon {
  flex: 0 0 auto;
}
.dawrak-app .work-stats .work-stat-card__body {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
}
.dawrak-app .work-stats .work-stat-card__label {
  margin: 0;
  color: #315c50;
  font-size: clamp(15px, 1.3vw, 18px);
  font-weight: 800;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.dawrak-app .work-stats .work-stat-card__value {
  margin: 0;
  color: #153e35;
  font-size: clamp(30px, 2.6vw, 38px);
  font-family: 'Alexandria', sans-serif;
  font-weight: 800;
  line-height: 1.12;
  direction: ltr;
  text-align: start;
}
@media (max-width: 570px) {
  .dawrak-app .work-dashboard .work-stats .work-stat-card { padding: 17px 14px; gap: 10px; min-height: 114px; }
  .dawrak-app .work-stats .work-stat-card__icon { padding: 8px; }
  .dawrak-app .work-stats .work-stat-card__label { font-size: 15px; }
  .dawrak-app .work-stats .work-stat-card__value { font-size: 32px; }
}
